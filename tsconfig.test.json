{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/tests/**/*.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/tests/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "./packages/protocol"
    },
    {
      "path": "./packages/pki"
    },
    {
      "path": "./packages/mitm-proxy"
    },
    {
      "path": "./packages/browser"
    },
    {
      "path": "./packages/world-state"
    },
    {
      "path": "./packages/scenarios"
    },
    {
      "path": "./packages/graders"
    },
    {
      "path": "./packages/agent-adapters"
    },
    {
      "path": "./packages/agent-tools"
    },
    {
      "path": "./packages/subagents"
    },
    {
      "path": "./packages/artifacts"
    },
    {
      "path": "./apps/world"
    },
    {
      "path": "./apps/runner"
    },
    {
      "path": "./apps/report"
    }
  ]
}
