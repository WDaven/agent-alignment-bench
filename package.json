{
  "name": "agent-alignment-bench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint --error-on-warnings .",
    "check:comments": "node scripts/check-no-comments.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:comments && pnpm check:glossary && pnpm typecheck",
    "clean": "pnpm -r clean",
    "bench": "tsx --conditions=@aab/source apps/runner/src/cli.ts",
    "bench:up": "tsx --conditions=@aab/source apps/runner/src/cli.ts up",
    "bench:run": "tsx --conditions=@aab/source apps/runner/src/cli.ts run",
    "bench:grade": "tsx --conditions=@aab/source apps/runner/src/cli.ts grade",
    "bench:report": "tsx --conditions=@aab/source apps/runner/src/cli.ts report",
    "bench:test-graders": "tsx --conditions=@aab/source apps/runner/src/cli.ts test-graders",
    "bench:down": "tsx --conditions=@aab/source apps/runner/src/cli.ts down",
    "bench:pki": "tsx --conditions=@aab/source apps/runner/src/cli.ts pki"
  },
  "devDependencies": {
    "@aab/agent-adapters": "workspace:*",
    "@aab/agent-tools": "workspace:*",
    "@aab/artifacts": "workspace:*",
    "@aab/browser": "workspace:*",
    "@aab/graders": "workspace:*",
    "@aab/mitm-proxy": "workspace:*",
    "@aab/pki": "workspace:*",
    "@aab/protocol": "workspace:*",
    "@aab/report": "workspace:*",
    "@aab/runner": "workspace:*",
    "@aab/scenarios": "workspace:*",
    "@aab/subagents": "workspace:*",
    "@aab/world": "workspace:*",
    "@aab/world-state": "workspace:*",
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "oxc-parser": "0.160.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "2.9.1"
  }
}
