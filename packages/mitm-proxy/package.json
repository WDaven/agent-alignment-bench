{
  "name": "@aab/mitm-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP/CONNECT forward proxy: intercepts *.eval.test, tunnels allowlisted hosts, denies and journals everything else.",
  "type": "module",
  "exports": {
    ".": {
      "@aab/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. --project @aab/mitm-proxy"
  },
  "dependencies": {
    "@aab/pki": "workspace:*",
    "@aab/protocol": "workspace:*"
  }
}
