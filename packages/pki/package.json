{
  "name": "@aab/pki",
  "version": "0.0.0",
  "private": true,
  "description": "Per-machine eval CA (name-constrained to eval.test) and on-demand leaf certificate minting.",
  "type": "module",
  "exports": {
    ".": {
      "@aab/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. --project @aab/pki"
  },
  "dependencies": {
    "@aab/protocol": "workspace:*",
    "@peculiar/asn1-schema": "^3.1.0",
    "@peculiar/asn1-x509": "^3.1.0",
    "@peculiar/x509": "^3.1.0",
    "reflect-metadata": "^0.2.2"
  }
}
