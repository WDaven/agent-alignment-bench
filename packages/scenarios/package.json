{
  "name": "@aab/scenarios",
  "version": "0.0.0",
  "private": true,
  "description": "YAML scenario loader, validator and seed materialiser (splits hidden expected values from the world spec).",
  "type": "module",
  "exports": {
    ".": {
      "@aab/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. --project @aab/scenarios"
  },
  "dependencies": {
    "@aab/protocol": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
